  "redFlags": [
    {
      "id": "dishonesty",
      "label": "Admitting dishonesty",
      "suggestion": "Pick an example where you were open about a mistake, or where you stayed honest under pressure.",
      "patterns": [
        "\\bi\\s+(?:(?:also|once|often|sometimes|usually|always|just|actually|really|even|totally|literally|have|had|then|finally|basically|honestly|kind of|sort of)\\s+){0,2}(?:lie|lied|lies|lying|faked|fake|fabricated|forged|falsified|made up)\\b",
        "\\bi\\s+(?:(?:also|once|often|sometimes|usually|always|just|actually|really|even|totally|literally|have|had|then|finally|basically|honestly|kind of|sort of)\\s+){0,2}(?:cheat|cheated|cheats|cheating)\\b",
        "\\b(?:lied|lying) to (?:my|the|a|our|his|her)\\b",
        "\\bi\\s+(?:(?:also|once|often|sometimes|usually|always|just|actually|really|even|totally|literally|have|had|then|finally|basically|honestly|kind of|sort of)\\s+){0,2}(?:covered|cover) (?:it )?up\\b",
        "\\bwithout (?:them|anyone|anybody|my manager|my boss|my teacher) (?:knowing|finding out|noticing)\\b"
      ]
    },
    {
      "id": "theft",
      "label": "Admitting theft",
      "suggestion": "Do not use this example. Choose one that shows you can be trusted with money, data or equipment.",
      "patterns": [
        "\\bi\\s+(?:(?:also|once|often|sometimes|usually|always|just|actually|really|even|totally|literally|have|had|then|finally|basically|honestly|kind of|sort of)\\s+){0,2}(?:stole|steal|steals|robbed|shoplifted|pocketed|embezzled)\\b",
        "\\btook (?:money|cash|stuff|things|items) (?:from|out of) (?:the|my|a) (?:till|register|company|shop|store|office|work|employer|boss)\\b"
      ]
    },
    {
      "id": "fraud",
      "label": "Admitting fraud or scamming",
      "suggestion": "Do not use this example. Choose one that shows you treat customers and colleagues fairly.",
      "patterns": [
        "\\bi\\s+(?:(?:also|once|often|sometimes|usually|always|just|actually|really|even|totally|literally|have|had|then|finally|basically|honestly|kind of|sort of)\\s+){0,2}(?:scam|scams|scammed|scamming|defraud|defrauded|swindle|swindled|conned|con|bribed|laundered)\\b",
        "\\b(?:scam|scammed|scamming|defrauded|swindled|conned) (?:people|customers|clients|old|the|my|some|them)\\b",
        "\\bi\\s+(?:(?:also|once|often|sometimes|usually|always|just|actually|really|even|totally|literally|have|had|then|finally|basically|honestly|kind of|sort of)\\s+){0,2}(?:committed|commit|did|do) fraud\\b"
      ]
    },
    {
      "id": "violence",
      "label": "Violence or threats",
      "suggestion": "Describe how you stayed calm and handled the conflict without aggression.",
      "patterns": [
        "\\bi\\s+(?:(?:also|once|often|sometimes|usually|always|just|actually|really|even|totally|literally|have|had|then|finally|basically|honestly|kind of|sort of)\\s+){0,2}(?:hit|punched|slapped|kicked|attacked|assaulted|beat up|threatened|shoved|choked)\\s+(?:him|her|them|a|my|the|someone|somebody|people)\\b",
        "\\bi\\s+(?:want|wanted|would like|wish)\\s+to\\s+(?:kill|hurt|punch|hit|beat up)\\b",
        "\\bi\\s+(?:(?:also|once|often|sometimes|usually|always|just|actually|really|even|totally|literally|have|had|then|finally|basically|honestly|kind of|sort of)\\s+){0,2}(?:yelled|screamed|shouted|swore) at\\b"
      ]
    },
    {
      "id": "hostility",
      "label": "Hostility or contempt",
      "suggestion": "Keep the story about what you did. If something was hard, say what you learned from it.",
      "patterns": [
        "\\bi\\s+(?:(?:also|once|often|sometimes|usually|always|just|actually|really|even|totally|literally|have|had|then|finally|basically|honestly|kind of|sort of)\\s+){0,2}(?:hate|hated|despise|despised)\\s+(?:my|the|every|all|most|people|customers|clients|working|work|team|group|managers?|bosses|teachers?)\\b"
      ]
    },
    {
      "id": "blaming",
      "label": "Blaming or badmouthing others",
      "suggestion": "Describe the situation neutrally and focus on your own part and what you did about it.",
      "patterns": [
        "\\b(?:my|the|our)\\s+(?:old |previous |last |former )?(?:boss|manager|supervisor|team|teammates?|colleagues?|co-?workers?|company|employer|teacher|professor|lecturer)\\s+(?:was|were|is|are)\\s+(?:(?:so|really|very|just|completely|totally|such)\\s+)?(?:an?\\s+)?(?:idiots?|stupid|useless|incompetent|lazy|terrible|awful|horrible|clueless|toxic|a joke|garbage|pathetic|morons?|losers?)\\b",
        "\\b(?:it was|that was|it's|that's) (?:all |entirely |completely )?(?:their|his|her|everyone else's|my (?:boss|manager|team)'s) fault\\b",
        "\\bnot my fault\\b",
        "\\bi\\s+(?:always )?blame(?:d)?\\s+(?:my|the|them|him|her|everyone|others)\\b"
      ]
    },
    {
      "id": "discrimination",
      "label": "Discriminatory remarks",
      "suggestion": "Avoid generalising about groups of people. Talk about individuals and what they did.",
      "patterns": [
        "\\b(?:women|girls|men|old people|older people|elderly|immigrants|foreigners|gay people|blacks?|muslims?|jews|asians?|disabled people|young people)\\s+(?:are|can't|cannot|shouldn't|don't|aren't)\\s+(?:\\w+\\s+){0,3}?(?:good|able|smart|capable|suited|lazy|stupid|dumb|worse|bad|inferior|lazier)\\b",
        "\\b(?:i|we)\\s+(?:don't|do not|wouldn't|would not|never)\\s+(?:like|hire|trust|work with)\\s+(?:women|girls|men|old people|older people|immigrants|foreigners|gay people|muslims?|jews|disabled people|young people)\\b"
      ]
    },
    {
      "id": "apathy",
      "label": "Not caring or only wanting the money",
      "suggestion": "Say what draws you to the work itself and what you would want to achieve in the role.",
      "patterns": [
        "\\bi\\s+(?:really\\s+)?(?:don't|do not|dont|didn't|did not)\\s+(?:really\\s+)?care\\b",
        "\\bi\\s+couldn't care less\\b",
        "\\bjust\\s+(?:for|about|here for|in it for)\\s+the\\s+(?:money|pay|paycheck|paycheque|salary)\\b",
        "\\bonly\\s+(?:here |applying |applied |working )?(?:for|because of|in it for)\\s+the\\s+(?:money|pay|salary|paycheck|paycheque)\\b",
        "\\bi\\s+(?:(?:also|once|often|sometimes|usually|always|just|actually|really|even|totally|literally|have|had|then|finally|basically|honestly|kind of|sort of)\\s+){0,2}(?:slack|slacked|slacking|goof|goofed|coast|coasted)(?:\\s+off)?\\b",
        "\\bdo (?:the )?(?:bare )?minimum\\b"
      ]
    },
    {
      "id": "substance",
      "label": "Substance use at work",
      "suggestion": "Do not use this example. Choose one that shows you are reliable and professional on the job.",
      "patterns": [
        "\\b(?:drunk|high|hungover|stoned|wasted)\\s+(?:at|on|during|while)\\s+(?:work|the job|shift|my shift)\\b",
        "\\b(?:came|went|showed up|turned up)\\s+(?:in\\s+)?(?:to work\\s+|to the office\\s+)?(?:drunk|high|hungover|stoned)\\b",
        "\\bi\\s+(?:drank|drink|smoked|did|took)\\s+(?:alcohol|weed|cannabis|drugs|cocaine|beer|vodka)\\s+(?:at|on|during|while)\\b",
        "\\bdrinking (?:at|on|during) (?:work|the job)\\b"
      ]
    },
    {
      "id": "rule_breaking",
      "label": "Breaking rules or confidentiality",
      "suggestion": "Show that you follow the rules, or that you raised a concern through the right channel.",
      "patterns": [
        "\\bi\\s+(?:(?:also|once|often|sometimes|usually|always|just|actually|really|even|totally|literally|have|had|then|finally|basically|honestly|kind of|sort of)\\s+){0,2}(?:broke|break|ignored|ignore|bypassed|bypass|violated|violate|skipped)\\s+(?:the\\s+|a\\s+|our\\s+|company\\s+|safety\\s+|all\\s+)*(?:rules?|polic(?:y|ies)|procedures?|regulations?|protocols?|laws?|safety)\\b",
        "\\b(?:rules|policies) (?:don't|do not|aren't|are not) (?:apply|for me)\\b",
        "\\bi\\s+(?:(?:also|once|often|sometimes|usually|always|just|actually|really|even|totally|literally|have|had|then|finally|basically|honestly|kind of|sort of)\\s+){0,2}(?:leaked|shared|told|sent)\\s+(?:\\w+\\s+){0,3}?(?:confidential|private|secret|sensitive|proprietary)\\b",
        "\\bi\\s+(?:don't|do not) (?:like )?(?:follow|following) (?:the )?(?:rules|orders|instructions|procedures)\\b"
      ]
    }
  ]
}
